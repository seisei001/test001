{
  "$schema": "./schemas/system.schema.json",
  "model": {
    "bertModelUrl": "https://cdn.jsdelivr.net/gh/seisei001/test001@resources/models/smart-box/bert-base-ja-int8.onnx",
    "tokenizerUrl": "https://cdn.jsdelivr.net/gh/seisei001/test001@resources/models/smart-box/tokenizer.json",
    "quantization": "int8",
    "rawEmbeddingDim": 768,
    "maxSequenceLength": 128,
    "expectedSizeMB": 30,
    "note": "分類ヘッドは使わない。embedding抽出専用(DESIGN.md 1.4節・5.1節)。"
  },
  "runtime": {
    "backend": "wasm",
    "executionProviders": ["wasm"],
    "numThreads": 4,
    "warmupOnLoad": true
  },
  "storage": {
    "indexedDBName": "conversation-rag-db",
    "indexedDBVersion": 1,
    "maxTurnsStored": 1000,
    "compressAfterTurns": 100,
    "quotaWarningMB": 40,
    "quotaHardLimitMB": 80
  },
  "logging": {
    "enabled": true,
    "level": "info",
    "persistToIndexedDB": true,
    "exportFormats": ["json", "csv"]
  },
  "experiments": {
    "abTestingEnabled": true,
    "stickyAssignment": true
  },
  "targets": {
    "note": "旧版のminIntentAccuracy/minEntityF1/minContextUnderstandingは意図分類ヘッド前提の指標だったため削除(DESIGN.md 8.5節)。代わりの指標はDESIGN.md 8.5節を参照(engagementScore等、Phase 1.5で計測)。",
    "maxInferenceLatencyMs": 500,
    "maxTotalTurnLatencyMs": 1000
  }
}
